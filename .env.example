# Banco de dados (PostgreSQL 16)
DATABASE_URL="postgresql://sinalplus:sinalplus@localhost:5432/sinalplus"

# Auth.js: gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""

# Domínio da plataforma. Tenants ficam em {slug}.PLATAFORMA_DOMINIO.
# Em desenvolvimento use "localhost" e acesse http://demo.localhost:3000
PLATAFORMA_DOMINIO="localhost"
# Nome mostrado apenas no domínio da plataforma (tenants usam o próprio nome).
PLATAFORMA_NOME="SinalPlus Telecom"

# Chave de 32 bytes (base64) para cifrar credenciais de IXC/SGP em repouso.
# Gere com `openssl rand -base64 32`
CREDENCIAIS_CHAVE=""

# Redis (filas BullMQ, a partir da Fase 2)
REDIS_URL="redis://localhost:6379"
